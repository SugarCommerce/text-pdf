{
  "name": "sugarmill/text-pdf",
  "version": "1.0.0",
  "description": "PDF generation with no dependencies. Invoices, statements and receipts with tables, vector SVG logos, multi-page flow, EU VAT treatments including reverse charge, and 11 languages. Injection-safe.",
  "type": "library",
  "license": "GPL-2.0-or-later",
  "homepage": "https://github.com/sugarmill/text-pdf",
  "authors": [
    {
      "name": "David Sherlock",
      "homepage": "https://arraypress.com/"
    }
  ],
  "keywords": [
    "pdf",
    "invoice",
    "receipt",
    "statement",
    "vat",
    "reverse-charge",
    "table",
    "svg",
    "report"
  ],
  "require": {
    "php": ">=8.5",
    "ext-iconv": "*",
    "ext-mbstring": "*"
  },
  "require-dev": {
    "phpunit/phpunit": "^13.0"
  },
  "autoload": {
    "psr-4": {
      "SugarMill\\TextPdf\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "SugarMill\\TextPdf\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit"
  },
  "config": {
    "optimize-autoloader": true,
    "sort-packages": true,
    "preferred-install": "dist"
  },
  "minimum-stability": "stable",
  "prefer-stable": true,
  "support": {
    "issues": "https://github.com/sugarmill/text-pdf/issues",
    "source": "https://github.com/sugarmill/text-pdf"
  }
}
